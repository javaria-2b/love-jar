rules_version = '2';
service cloud.firestore {
  match /databasesvery/{database}/documents {

    // Jars collection
    match /jars/{jarId} {
      // Anyone can read a jar they know the ID of (passcode-protected)
      allow read: if true;

      // Create: must be authenticated and be the first member
      allow create: if request.auth != null
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid;

      // Update: must be a member of this jar
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members;

      // No deletion (preserve the jar)
      allow delete: if false;

      // Memories subcollection
      match /memories/{memoryId} {
        // Members can read all memories
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/jars/$(jarId)).data.members;

        // Members can create memories
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/jars/$(jarId)).data.members
          && request.resource.data.createdBy == request.auth.uid;

        // Only creator can update their own memory
        allow update: if request.auth != null
          && request.auth.uid == resource.data.createdBy;

        // No deletion (preserve memories)
        allow delete: if false;
      }

      // Presence subcollection
      match /presence/{uid} {
        // Members can read presence
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/jars/$(jarId)).data.members;

        // Users can only write their own presence
        allow write: if request.auth != null
          && request.auth.uid == uid;
      }
    }
  }
}
